; Survivors Arena: the Godot client. It draws server views and sends intents; it holds no game rules.
; See docs/arena/GODOT_FOUNDATION.md for the contract.

config_version=5

[application]

config/name="Survivors"
config/description="Live 4-seat Survivors client (PC and Android)."
config/version="0.1.0-foundation"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0431373, 0.0666667, 0.12549, 1)

[autoload]

Log="*res://autoload/log.gd"
Net="*res://autoload/net.gd"
Session="*res://autoload/session.gd"
Themes="*res://autoload/themes.gd"
Feed="*res://autoload/model_feed.gd"
Intents="*res://autoload/intents.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=2
