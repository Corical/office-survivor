erse":false},{"id":231,"effect":{"effect":"cross_dissolve","enabled":true,"params":{}},"start":36129542400000,"duration":76204800000,"from":173,"to":174,"align":"CenterAtCut","reverse":false}],"locked":false,"sync_lock":true,"enabled":true,"muted":false,"solo":false,"channels":"Stereo","volume_db":0.0,"pan":0.0,"effects":[],"mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"}},{"id":141,"kind":"Video","name":"Video 2","items":[],"transitions":[],"locked":false,"sync_lock":true,"enabled":true,"muted":false,"solo":false,"channels":"Stereo","volume_db":0.0,"pan":0.0,"effects":[],"mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"}}],"audio_tracks":[{"id":142,"kind":"Audio","name":"Audio 1","items":[{"id":160,"item":145,"name":"mix.wav","label":"Caribbean","start":0,"duration":40312339200000,"source_in":0,"speed":1.0,"reverse":false,"enabled":true,"link":null,"group":null,"effects":[{"effect":"volume","enabled":true,"params":{"bypass":{"value":{"Bool":false}},"level":{"value":{"Float":0.0}}}},{"effect":"channel_volume","enabled":true,"params":{"bypass":{"value":{"Bool":false}},"left":{"value":{"Float":0.0}},"right":{"value":{"Float":0.0}}}},{"effect":"panner","enabled":true,"params":{"balance":{"value":{"Float":0.0}}}}],"markers":[],"gain_db":0.0,"frame_hold":null,"scale_to_frame":false}],"transitions":[],"locked":false,"sync_lock":true,"enabled":true,"muted":false,"solo":false,"channels":"Stereo","volume_db":0.0,"pan":0.0,"effects":[],"mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"}},{"id":143,"kind":"Audio","name":"Audio 2","items":[],"transitions":[],"locked":false,"sync_lock":true,"enabled":true,"muted":false,"solo":false,"channels":"Stereo","volume_db":0.0,"pan":0.0,"effects":[],"mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"}}],"markers":[],"mark_in":null,"mark_out":null,"work_area":null,"start_timecode":0,"master_volume_db":0.0,"master_effects":[],"master_mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"},"submix_tracks":[],"caption_tracks":[{"id":175,"name":"English","format":"Subtitle","language":"en","style":{"font":"Inter","size":44.0,"color":[244,241,232,255],"background":true,"background_color":[0,0,0,179],"align":"Center","anchor":"Bottom","margin":0.06,"line_spacing":1.25,"outline":0.0,"outline_color":[0,0,0,255]},"enabled":true,"locked":false,"sync_lock":true,"captions":[{"id":176,"start":33868800000,"duration":1016064000000,"text":"For the next two weeks, the\noffice becomes a survival game.","speaker":null,"cue_id":null,"settings":""},{"id":177,"start":1066867200000,"duration":1117670400000,"text":"Food is scarce, everyone is hungry,\nand anyone could turn on you.","speaker":null,"cue_id":null,"settings":""},{"id":178,"start":2396217600000,"duration":567302400000,"text":"The game runs for ten workdays.","speaker":null,"cue_id":null,"settings":""},{"id":179,"start":2980454400000,"duration":821318400000,"text":"Your goal: stay alive,\nand on the last night,","speaker":null,"cue_id":null,"settings":""},{"id":180,"start":3810240000000,"duration":880588800000,"text":"grab one of five seats\non the rescue helicopter.","speaker":null,"cue_id":null,"settings":""},{"id":181,"start":4910976000000,"duration":618105600000,"text":"Everyone starts with seven rations.","speaker":null,"cue_id":null,"settings":""},{"id":182,"start":5546016000000,"duration":431827200000,"text":"Every night, you eat one.","speaker":null,"cue_id":null,"settings":""},{"id":183,"start":5994777600000,"duration":939859200000,"text":"Run out, and you become a\nbandit. More on that later.","speaker":null,"cue_id":null,"settings":""},{"id":184,"start":7146316800000,"duration":1109203200000,"text":"Each day, you pick one secret\nmove in Discord before midnight.","speaker":null,"cue_id":null,"settings":""},{"id":185,"start":8272454400000,"duration":618105600000,"text":"Nobody else can see what you chose.","speaker":null,"cue_id":null,"settings":""},{"id":186,"start":8907494400000,"duration":381024000000,"text":"You have five options.","speaker":null,"cue_id":null,"settings":""},{"id":187,"start":9508665600000,"duration":1202342400000,"text":"Scavenge. Go looking for food and\nfind nothing, one or two rations.","speaker":null,"cue_id":null,"settings":""},{"id":188,"start":10727942400000,"duration":889056000000,"text":"If you forget to play, you\nscavenge automatically.","speaker":null,"cue_id":null,"settings":""},{"id":189,"start":11820211200000,"duration":838252800000,"text":"Steal. Pick someone and take\nup to two of their rations.","speaker":null,"cue_id":null,"settings":""},{"id":190,"start":12666931200000,"duration":440294400000,"text":"They'll know they were robbed.","speaker":null,"cue_id":null,"settings":""},{"id":191,"start":13124160000000,"duration":397958400000,"text":"They won't know it was you.","speaker":null,"cue_id":null,"settings":""},{"id":192,"start":13725331200000,"duration":838252800000,"text":"Guard. You're protected\ntonight and tomorrow night.","speaker":null,"cue_id":null,"settings":""},{"id":193,"start":14580518400000,"duration":965260800000,"text":"Anyone who tries to rob you\ngets caught, named in the news,","speaker":null,"cue_id":null,"settings":""},{"id":194,"start":15562713600000,"duration":499564800000,"text":"and pays you up to two rations.","speaker":null,"cue_id":null,"settings":""},{"id":195,"start":16070745600000,"duration":804384000000,"text":"You only get three guards,\nso choose your moment.","speaker":null,"cue_id":null,"settings":""},{"id":196,"start":17078342400000,"duration":1168473600000,"text":"Investigate. Spy on one person and\nfind out what they did that night.","speaker":null,"cue_id":null,"settings":""},{"id":197,"start":18255283200000,"duration":1371686400000,"text":"Catch them stealing, and they're exposed\nand pay you one ration, if they have it.","speaker":null,"cue_id":null,"settings":""},{"id":198,"start":19847116800000,"duration":795916800000,"text":"Gift. Give some of your\nfood to someone else.","speaker":null,"cue_id":null,"settings":""},{"id":199,"start":20651500800000,"duration":863654400000,"text":"Nobody is told, unless\nsomeone was spying on you.","speaker":null,"cue_id":null,"settings":""},{"id":200,"start":21726835200000,"duration":1244678400000,"text":"Every morning at half past seven, the\nnews drops in Discord: who got robbed,","speaker":null,"cue_id":null,"settings":""},{"id":201,"start":22979980800000,"duration":651974400000,"text":"who got caught, and who ran out of food.","speaker":null,"cue_id":null,"settings":""},{"id":202,"start":23640422400000,"duration":533433600000,"text":"You'll always know what happened.","speaker":null,"cue_id":null,"settings":""},{"id":203,"start":24182323200000,"duration":482630400000,"text":"You'll rarely know who did it.","speaker":null,"cue_id":null,"settings":""},{"id":204,"start":24876633600000,"duration":1016064000000,"text":"Run out of food and you're\na bandit. Bandits don't eat.","speaker":null,"cue_id":null,"settings":""},{"id":205,"start":25901164800000,"duration":1049932800000,"text":"They can only steal one ration\nat a time, or investigate.","speaker":null,"cue_id":null,"settings":""},{"id":206,"start":26959564800000,"duration":1007596800000,"text":"Get back to three rations\nand you rejoin the survivors.","speaker":null,"cue_id":null,"settings":""},{"id":207,"start":28178841600000,"duration":1032998400000,"text":"You'll also get a secret goal\nthat only you know about.","speaker":null,"cue_id":null,"settings":""},{"id":208,"start":29220307200000,"duration":1320883200000,"text":"And once a day you can post an\nanonymous message on the radio channel.","speaker":null,"cue_id":null,"settings":""},{"id":209,"start":30549657600000,"duration":651974400000,"text":"Tips, accusations, lies. Your call.","speaker":null,"cue_id":null,"settings":""},{"id":210,"start":31404844800000,"duration":711244800000,"text":"On the last night, the helicopter lands.","speaker":null,"cue_id":null,"settings":""},{"id":211,"start":32133024000000,"duration":872121600000,"text":"The five survivors with\nthe most food get a seat.","speaker":null,"cue_id":null,"settings":""},{"id":212,"start":33013612800000,"duration":1363219200000,"text":"Staying alive earns points, a seat earns\nmore, and so does your secret goal.","speaker":null,"cue_id":null,"settings":""},{"id":213,"start":34385299200000,"duration":296352000000,"text":"Most points wins.","speaker":null,"cue_id":null,"settings":""},{"id":214,"start":34690118400000,"duration":1303948800000,"text":"Then comes the big reveal: every theft\nand every secret, out in the open.","speaker":null,"cue_id":null,"settings":""},{"id":215,"start":36205747200000,"duration":939859200000,"text":"It takes two minutes a day,\nit's completely optional,","speaker":null,"cue_id":null,"settings":""},{"id":216,"start":37154073600000,"duration":990662400000,"text":"and nothing in the game touches\nreal work or real money.","speaker":null,"cue_id":null,"settings":""},{"id":217,"start":38153203200000,"duration":1490227200000,"text":"Type slash join in Discord and you'll get\na secret alias, so nobody knows who's who.","speaker":null,"cue_id":null,"settings":""},{"id":218,"start":39660364800000,"duration":465696000000,"text":"And remember: trust no one.","speaker":null,"cue_id":null,"settings":""}],"vtt_blocks":[]}]}},"metadata":{},"created":144},"145":{"id":145,"name":"mix.wav","label":"Caribbean","kind":{"Media":{"media":{"File":{"path":"C:/Personal/office-survivor/docs/video/output/03_audio/mix.wav"}},"info":{"name":"mix.wav","kind":"AudioOnly","duration":40312339200000,"video":null,"audio_streams":[{"sample_rate":48000,"channels":2,"codec":"PCM","bits_per_sample":24}],"container":"WAV","start_timecode":null,"file_size":45705704},"interpret":{"frame_rate":null,"par":null,"ignore_alpha":false,"invert_alpha":fal