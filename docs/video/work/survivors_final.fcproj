t":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"}},{"id":51,"kind":"Audio","name":"Audio 2","items":[],"transitions":[],"locked":false,"sync_lock":true,"enabled":true,"muted":false,"solo":false,"channels":"Stereo","volume_db":0.0,"pan":0.0,"effects":[],"mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"}}],"markers":[],"mark_in":null,"mark_out":null,"work_area":null,"start_timecode":0,"master_volume_db":0.0,"master_effects":[],"master_mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"},"submix_tracks":[],"caption_tracks":[{"id":55,"name":"English","format":"Subtitle","language":"en","style":{"font":"Inter","size":44.0,"color":[244,241,232,255],"background":true,"background_color":[0,0,0,179],"align":"Center","anchor":"Bottom","margin":0.06,"line_spacing":1.25,"outline":0.0,"outline_color":[0,0,0,255]},"enabled":true,"locked":false,"sync_lock":true,"captions":[{"id":56,"start":33868800000,"duration":1016064000000,"text":"For the next two weeks, the\noffice becomes a survival game.","speaker":null,"cue_id":null,"settings":""},{"id":57,"start":1066867200000,"duration":1117670400000,"text":"Food is scarce, everyone is hungry,\nand anyone could turn on you.","speaker":null,"cue_id":null,"settings":""},{"id":58,"start":2396217600000,"duration":567302400000,"text":"The game runs for ten workdays.","speaker":null,"cue_id":null,"settings":""},{"id":59,"start":2980454400000,"duration":821318400000,"text":"Your goal: stay alive,\nand on the last night,","speaker":null,"cue_id":null,"settings":""},{"id":60,"start":3810240000000,"duration":880588800000,"text":"grab one of five seats\non the rescue helicopter.","speaker":null,"cue_id":null,"settings":""},{"id":61,"start":4910976000000,"duration":618105600000,"text":"Everyone starts with seven rations.","speaker":null,"cue_id":null,"settings":""},{"id":62,"start":5546016000000,"duration":431827200000,"text":"Every night, you eat one.","speaker":null,"cue_id":null,"settings":""},{"id":63,"start":5994777600000,"duration":939859200000,"text":"Run out, and you become a\nbandit. More on that later.","speaker":null,"cue_id":null,"settings":""},{"id":64,"start":7146316800000,"duration":1109203200000,"text":"Each day, you pick one secret\nmove in Discord before midnight.","speaker":null,"cue_id":null,"settings":""},{"id":65,"start":8272454400000,"duration":618105600000,"text":"Nobody else can see what you chose.","speaker":null,"cue_id":null,"settings":""},{"id":66,"start":8907494400000,"duration":381024000000,"text":"You have five options.","speaker":null,"cue_id":null,"settings":""},{"id":67,"start":9508665600000,"duration":1202342400000,"text":"Scavenge. Go looking for food and\nfind nothing, one or two rations.","speaker":null,"cue_id":null,"settings":""},{"id":68,"start":10727942400000,"duration":889056000000,"text":"If you forget to play, you\nscavenge automatically.","speaker":null,"cue_id":null,"settings":""},{"id":69,"start":11820211200000,"duration":838252800000,"text":"Steal. Pick someone and take\nup to two of their rations.","speaker":null,"cue_id":null,"settings":""},{"id":70,"start":12666931200000,"duration":440294400000,"text":"They'll know they were robbed.","speaker":null,"cue_id":null,"settings":""},{"id":71,"start":13124160000000,"duration":397958400000,"text":"They won't know it was you.","speaker":null,"cue_id":null,"settings":""},{"id":72,"start":13725331200000,"duration":838252800000,"text":"Guard. You're protected\ntonight and tomorrow night.","speaker":null,"cue_id":null,"settings":""},{"id":73,"start":14580518400000,"duration":965260800000,"text":"Anyone who tries to rob you\ngets caught, named in the news,","speaker":null,"cue_id":null,"settings":""},{"id":74,"start":15562713600000,"duration":499564800000,"text":"and pays you up to two rations.","speaker":null,"cue_id":null,"settings":""},{"id":75,"start":16070745600000,"duration":804384000000,"text":"You only get three guards,\nso choose your moment.","speaker":null,"cue_id":null,"settings":""},{"id":76,"start":17078342400000,"duration":1168473600000,"text":"Investigate. Spy on one person and\nfind out what they did that night.","speaker":null,"cue_id":null,"settings":""},{"id":77,"start":18255283200000,"duration":1371686400000,"text":"Catch them stealing, and they're exposed\nand pay you one ration, if they have it.","speaker":null,"cue_id":null,"settings":""},{"id":78,"start":19847116800000,"duration":795916800000,"text":"Gift. Give some of your\nfood to someone else.","speaker":null,"cue_id":null,"settings":""},{"id":79,"start":20651500800000,"duration":863654400000,"text":"Nobody is told, unless\nsomeone was spying on you.","speaker":null,"cue_id":null,"settings":""},{"id":80,"start":21726835200000,"duration":1244678400000,"text":"Every morning at half past seven, the\nnews drops in Discord: who got robbed,","speaker":null,"cue_id":null,"settings":""},{"id":81,"start":22979980800000,"duration":651974400000,"text":"who got caught, and who ran out of food.","speaker":null,"cue_id":null,"settings":""},{"id":82,"start":23640422400000,"duration":533433600000,"text":"You'll always know what happened.","speaker":null,"cue_id":null,"settings":""},{"id":83,"start":24182323200000,"duration":482630400000,"text":"You'll rarely know who did it.","speaker":null,"cue_id":null,"settings":""},{"id":84,"start":24876633600000,"duration":677376000000,"text":"Run out of food and you're a bandit.","speaker":null,"cue_id":null,"settings":""},{"id":85,"start":25562476800000,"duration":711244800000,"text":"Bandits can only steal or investigate,","speaker":null,"cue_id":null,"settings":""},{"id":86,"start":26282188800000,"duration":1109203200000,"text":"but get back to three rations\nand you rejoin the survivors.","speaker":null,"cue_id":null,"settings":""},{"id":87,"start":27594604800000,"duration":1032998400000,"text":"You'll also get a secret goal\nthat only you know about.","speaker":null,"cue_id":null,"settings":""},{"id":88,"start":28636070400000,"duration":1320883200000,"text":"And once a day you can post an\nanonymous message on the radio channel.","speaker":null,"cue_id":null,"settings":""},{"id":89,"start":29965420800000,"duration":651974400000,"text":"Tips, accusations, lies. Your call.","speaker":null,"cue_id":null,"settings":""},{"id":90,"start":30820608000000,"duration":711244800000,"text":"On the last night, the helicopter lands.","speaker":null,"cue_id":null,"settings":""},{"id":91,"start":31548787200000,"duration":872121600000,"text":"The five survivors with\nthe most food get a seat.","speaker":null,"cue_id":null,"settings":""},{"id":92,"start":32429376000000,"duration":1363219200000,"text":"Staying alive earns points, a seat earns\nmore, and so does your secret goal.","speaker":null,"cue_id":null,"settings":""},{"id":93,"start":33801062400000,"duration":296352000000,"text":"Most points wins.","speaker":null,"cue_id":null,"settings":""},{"id":94,"start":34105881600000,"duration":1303948800000,"text":"Then comes the big reveal: every theft\nand every secret, out in the open.","speaker":null,"cue_id":null,"settings":""},{"id":95,"start":35621510400000,"duration":939859200000,"text":"It takes two minutes a day,\nit's completely optional,","speaker":null,"cue_id":null,"settings":""},{"id":96,"start":36569836800000,"duration":990662400000,"text":"and nothing in the game touches\nreal work or real money.","speaker":null,"cue_id":null,"settings":""},{"id":97,"start":37568966400000,"duration":1490227200000,"text":"Type slash join in Discord and you'll get\na secret alias, so nobody knows who's who.","speaker":null,"cue_id":null,"settings":""},{"id":98,"start":39076128000000,"duration":465696000000,"text":"And remember: trust no one.","speaker":null,"cue_id":null,"settings":""}],"vtt_blocks":[]}]}},"metadata":{},"created":52},"53":{"id":53,"name":"mix.wav","label":"Caribbean","kind":{"Media":{"media":{"File":{"path":"C:/Personal/office-survivor/docs/video/output/03_audio/mix.wav"}},"info":{"name":"mix.wav","kind":"AudioOnly","duration":40312339200000,"video":null,"audio_streams":[{"sample_rate":48000,"channels":2,"codec":"PCM","bits_per_sample":24}],"container":"WAV","start_timecode":null,"file_size":45705704},"interpret":{"frame_rate":null,"par":null,"ignore_alpha":false,"invert_alpha":false},"mark_in":null,"mark_out":null,"markers":[],"offline":false,"proxy":null,"identity":{"size":45705704,"fingerprint":"7f3bc5886bfe4378"}}},"metadata":{},"created":53},"99":{"id":99,"name":"scene_01.mp4","label":"Violet","kind":{"Media":{"media":{"File":{"path":"C:/Personal/office-survivor/docs/video/output/04_scenes/scene_01.mp4"}},"info":{"name":"scene_01.mp4","kind":"Movie","duration":2362348800000,"video":{"width":1920,"height":1080,"frame_rate":{"num":30,"den":1},"par":[1,1],"codec":"H.264 (High)","pixel_format":"YUV 4:2:0 8-bit","color":{"matrix":"Bt709","transfer":"Bt709","primaries":"Bt709","range":"Limited"},"has_alpha":false,"bitrate":8790633},"audio_streams":[],"container":"MPEG-4","start_timecode":null,"file_size":10222516},"interpret":{"frame_rate":null,"par":null,"ignore_alpha":false,"invert_alpha":false},"mark_in":null,"mark_out":null,"markers":[],"offline":false,"proxy":null,"identity":{"size":10222516,"fingerprint":"b3f885670a63a5c4"}}},"metadata":{},"created":99},"100":{"id":100,"name":"scene_02.mp4","label":"Violet","kind":{"Media":{"media":{"File":{"path":"C:/Personal/office-survivor/docs/video/output/04_scenes/scene_02.mp4"}},"info":{"name":"scene_02.mp4","kind":"Movie","duration":2514758400000,"video":{"width":1920,"height":1080,"frame_rate":{"num":30,"den":1},"par":[1,1],"codec":"H.264 (High)","pixel_format":"YUV 4:2:0 8-bit","color":{"matrix":"Bt709","transfer":"Bt709","primaries":"Bt709","range":"Limited"},"has_alpha":false,"bitrate":1218698},"audio_streams":[],"container":"MPEG-4","start_timecode":null,"file_size":1511741},"interpret":{"frame_rate":null,"par":null,"ignore_alpha":false,"invert_alpha":fal